{
  "name": "ddangkong",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:worker": "vitest run --config workers/realtime/vitest.config.mts",
    "realtime:dev": "wrangler dev --config workers/realtime/wrangler.jsonc --env local --port 8787",
    "realtime:deploy": "wrangler deploy --config workers/realtime/wrangler.jsonc",
    "test:e2e": "playwright test",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "twa:init": "cd android && pnpm dlx @bubblewrap/cli@1.27.0 init --manifest=https://ddangkong.suulab.xyz/manifest.json --directory=.",
    "twa:build": "pwsh -NoProfile -File scripts/build-android.ps1",
    "twa:update": "cd android && pnpm dlx @bubblewrap/cli@1.27.0 update --manifest=./twa-manifest.json --skipVersionUpgrade",
    "prepare": "husky",
    "test:relay": "node scripts/test-drawing-relay.mjs"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "^5.15.8",
    "@types/node": "25.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.27",
    "clsx": "^2.1.1",
    "eslint-config-next": "16.4.3",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.34.5",
    "html2canvas": "^1.4.1",
    "next": "16.4.3",
    "postcss": "8.5.26",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-h5-audio-player": "^3.10.1",
    "react-transition-group": "^4.4.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "@playwright/test": "1.64.1",
    "@types/file-saver": "^2.0.7",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "7.36.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "file-loader": "^6.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "postcss-nesting": "^14.0.0",
    "postcss-preset-env": "^9.6.0",
    "prettier": "^3.8.1",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "^7.29.6",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": "^7.29.4",
      "flatted@<3.4.2": "^3.4.2",
      "lodash@<4.18.0": "^4.18.0",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@<8.5.12": "^8.5.12",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=3.0.0 <5.0.12": "^5.0.12",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "serialize-javascript": "^7.1.3",
      "sharp@<0.35.5": "^0.35.5",
      "svgo@>=3.0.0 <3.3.5": "^3.3.5",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.20",
      "postcss-selector-parser@>=6.0.0 <6.1.5": "^6.1.5",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "^7.1.7",
      "browserslist@<4.28.7": "^4.29.5",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.34",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "zod@>=4.0.0 <4.6.6": "^4.6.6",
      "undici@>=7.0.0 <7.30.1": "^7.30.1"
    }
  }
}
