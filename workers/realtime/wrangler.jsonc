{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ddangkong-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "observability": { "enabled": true },
  "vars": { "ALLOWED_ORIGINS": "https://ddangkong.suulab.xyz" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "CREATION_LIMITERS", "class_name": "CreationLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject", "CreationLimiter"] }],
  "env": {
    "local": {
      "vars": { "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000" },
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "RoomDurableObject" },
          { "name": "CREATION_LIMITERS", "class_name": "CreationLimiter" }
        ]
      }
    }
  }
}
